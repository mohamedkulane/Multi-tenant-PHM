{
  "name": "phms-multi-tenant-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Secure multi-tenant pharmacy management platform",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @phms/api\" \"npm run dev -w @phms/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @phms/api",
    "db:validate": "npm run db:validate -w @phms/api",
    "db:migrate": "npm run db:migrate -w @phms/api",
    "db:studio": "npm run db:studio -w @phms/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "type": "module"
}
