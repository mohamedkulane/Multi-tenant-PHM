NODE_ENV=development
PORT=5001
APP_BASE_URL=http://127.0.0.1:5001
WEB_ORIGINS=http://127.0.0.1:5173

# Create this database and role through pgAdmin 4 using docs/LOCAL_POSTGRESQL_PGADMIN.md.
DATABASE_URL=postgresql://phms_app:replace-with-local-password@localhost:5432/phms_dev?schema=public

# Use at least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_COOKIE_NAME=phms_session
SESSION_TTL_HOURS=12

# Keep 0 when the API is directly exposed. Set the exact trusted proxy hop count
# only when deployed behind infrastructure you control.
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug
# Optional: seed the clinical demo catalog and patient into an existing tenant.
PHMS_SEED_TENANT_SLUG=

# Optional platform email verification and recovery. Uncomment and configure all
# values on the server; never commit a real SMTP password. Production URL must be HTTPS.
# PLATFORM_WEB_URL=https://phms.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=accounts@example.com
